# Copie para .env e preencha. O .env nunca deve ir para o git nem para dentro do app.
# Gere segredos com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# ---------- Tutor de IA ----------
# Ordem de uso: o primeiro responde; se der erro ou ficar sem crédito, o próximo assume sozinho.
AI_PROVIDER_ORDER=gemini,deepseek,openrouter
# Tempo máximo de espera por provedor (ms) e pausa de quem ficou sem crédito (min)
AI_TIMEOUT_MS=45000
AI_QUOTA_COOLDOWN_MIN=30

# Gemini (aistudio.google.com > Get API key). Tem plano grátis com limite diário.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Chave da API do DeepSeek (platform.deepseek.com > API keys). Começa com sk-
DEEPSEEK_API_KEY=

# Modelo do DeepSeek
DEEPSEEK_MODEL=deepseek-chat

# OpenRouter (openrouter.ai > Keys). openrouter/free escolhe um modelo grátis que aceita ferramentas.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# ---------- Servidor ----------
# Endereço da API. 127.0.0.1 = só este computador; use 0.0.0.0 para aceitar conexões de outras máquinas
HOST=127.0.0.1
PORT=8787

# Limite de requisições por minuto por cliente (tutor) e para login/cadastro
RATE_LIMIT_PER_MIN=30
AUTH_RATE_LIMIT_PER_MIN=10

# ---------- Banco (MySQL do docker-compose.yml) ----------
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=lance_a_lance
DB_USER=lance_app
DB_PASSWORD=
# Senha do root do MySQL: só o docker-compose, pnpm db:users e o backup usam (a API entra com DB_USER)
MYSQL_ROOT_PASSWORD=
# Usuário só das migrações (pnpm db:migrate): DML + CREATE/ALTER/DROP/INDEX/REFERENCES no banco.
# A API (DB_USER) tem só SELECT/INSERT/UPDATE/DELETE. Os dois são criados/ajustados por pnpm db:users.
DB_MIGRATE_USER=lance_migrator
DB_MIGRATE_PASSWORD=
# TLS com o MySQL: sempre obrigatório (único valor aceito: required). A CA é gerada por pnpm db:tls em
# db/tls/ (fora do git e do app). Caminho relativo à pasta api/. Sem o arquivo, a API não sobe.
DB_SSL=required
DB_SSL_CA=db/tls/ca.pem

# ---------- Autenticação ----------
# Segredo do JWT (HS256), com pelo menos 32 caracteres. Trocar este valor desloga todo mundo.
JWT_SECRET=
# Validade do login: 30m, 12h, 7d...
JWT_EXPIRES_IN=12h
